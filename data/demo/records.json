  "requirement": {
    "REQ-VOER-1": {
      "id": "REQ-VOER-1",
      "text": "Die Vorerkrankungsanfrage (Abgabegrund 41) darf nur ausgelöst werden, wenn eine AU-Bescheinigung für die aktuelle AU vorliegt, mindestens eine bescheinigte potentielle Vorerkrankung in den letzten 6 Monaten vor AU-Beginn im Datenbestand liegt und die kumulierten Vorzeiten der letzten 12 Monate zusammen mit der aktuellen AU zum Zeitpunkt der Meldung mindestens 30 Tage umfassen.",
      "source_id": "SRC-VB",
      "citation": "S. 135, §3.12 (VB DTA EEL V13.4)",
      "status": "approved"
    }
  },
  "criterion": {
    "CRIT-EAZ-1": {
      "id": "CRIT-EAZ-1",
      "requirement_id": "REQ-VOER-1",
      "description": "Für §3.1-Sachverhalte überträgt das Abrechnungsprogramm den offiziellen DSLW/DBAL/DBAE-Erwartungsdatensatz (Beispielpapier V13.3 §3.1 S. 9–11; Abwandlung §3.2.1.4 S. 12).",
      "expected_basis": "Beispielpapier DTA EEL V13.3 (gültig ab 01.01.2027), §3.1, S. 9–11: DSLW (S. 9–10), DBAL (S. 10), DBAE (S. 11). Offizielle Erwartungswerte für die Abgabeseite des Entgeltabrechnungsprogramms (Transmit-Seite); keine Leistungsbeitragsbehauptung.",
      "review_status": "approved"
    },
    "CRIT-VOER-1": {
      "id": "CRIT-VOER-1",
      "requirement_id": "REQ-VOER-1",
      "description": "DBVO (Abgabegrund 41) genau dann, wenn die VB §3.12-Trigger erfüllt sind (≥1 bescheinigte Vorerkrankung/6 Monate; ≥30 Tage kumuliert/12 Monate).",
      "expected_basis": "Verfahrensbeschreibung DTA EEL V13.4 §3.12 (S. 135–136): Anfrage nur wenn (a) AU-Bescheinigung für aktuelle AU vorliegt, (b) mindestens eine bescheinigte potentielle Vorerkrankung in den letzten 6 Monaten vor AU-Beginn, (c) kumulierte Zeiten aller potentiellen Vorerkrankungen in den letzten 12 Monaten zusammen mit der aktuellen AU zum Zeitpunkt der Meldung mindestens 30 Tage. Konstellation: 2+17+3+3=25 Tage Vorzeiten + 10 Tage aktuelle AU = 35 ≥ 30; letzte attestierte AU endet 03.03.2026, 8 Tage vor AU-Beginn (≤ 6 Monate).",
      "review_status": "approved"
    }
  },
